# =============================================================================
# モデル選択ファイル
# =============================================================================
# 使いたいモデルの 2 行（HF_REPO と HF_FILE）だけコメントインし、
# それ以外はコメントアウトしてください。**有効にできるのは 1 モデルだけ**です。
# （複数コメントインすると、ファイル内で最後に書かれたものが優先されます）
#
# 反映手順:
#   make switch          # 既存モデルを削除して、選択中のモデルを再取得
#   （または）
#   make clean-model && make download
#
# すべて Q4_K_M 量子化（4bit、サイズと品質のバランス型）。括弧内はおおよその DL サイズ。
# 一時的に別モデルを試すだけなら、ここを編集せず CLI で上書きも可:
#   make switch HF_REPO=... HF_FILE=...
# -----------------------------------------------------------------------------

# ---- Llama 3.2 (Meta) -------------------------------------------------------
# HF_REPO="bartowski/Llama-3.2-1B-Instruct-GGUF";  HF_FILE="Llama-3.2-1B-Instruct-Q4_K_M.gguf"   # 1B  (~0.8GB)
# HF_REPO="bartowski/Llama-3.2-3B-Instruct-GGUF";  HF_FILE="Llama-3.2-3B-Instruct-Q4_K_M.gguf"   # 3B  (~2.0GB)

# ---- Qwen3 (Alibaba) --------------------------------------------------------
# llama-cpp-python==0.3.28 で Qwen3 アーキ対応済み。思考モードは app.py の
# SYSTEM_PROMPT 末尾 `/no_think` で無効化（nothink 運用）。
# HF_REPO="bartowski/Qwen_Qwen3-0.6B-GGUF";        HF_FILE="Qwen_Qwen3-0.6B-Q4_K_M.gguf"          # 0.6B (~0.5GB)
HF_REPO="bartowski/Qwen_Qwen3-1.7B-GGUF";        HF_FILE="Qwen_Qwen3-1.7B-Q4_K_M.gguf"          # 1.7B (~1.1GB)
# HF_REPO="Qwen/Qwen3-4B-GGUF";                    HF_FILE="Qwen3-4B-Q4_K_M.gguf"                 # 4B  (~2.5GB)

# ---- Gemma 3 (Google) -------------------------------------------------------
# HF_REPO="ggml-org/gemma-3-1b-it-GGUF";           HF_FILE="gemma-3-1b-it-Q4_K_M.gguf"            # 1B  (~0.8GB)
# HF_REPO="ggml-org/gemma-3-4b-it-GGUF";           HF_FILE="gemma-3-4b-it-Q4_K_M.gguf"            # 4B  (~2.5GB)

# ---- Phi-4-mini (Microsoft) -------------------------------------------------
# HF_REPO="unsloth/Phi-4-mini-instruct-GGUF";      HF_FILE="Phi-4-mini-instruct-Q4_K_M.gguf"      # 4B  (~2.5GB)

# ---- SmolLM2 (Hugging Face) -------------------------------------------------
# HF_REPO="bartowski/SmolLM2-135M-Instruct-GGUF";  HF_FILE="SmolLM2-135M-Instruct-Q4_K_M.gguf"    # 135M (~0.1GB)
# HF_REPO="bartowski/SmolLM2-360M-Instruct-GGUF";  HF_FILE="SmolLM2-360M-Instruct-Q4_K_M.gguf"    # 360M (~0.3GB)
# HF_REPO="HuggingFaceTB/SmolLM2-1.7B-Instruct-GGUF"; HF_FILE="smollm2-1.7b-instruct-q4_k_m.gguf" # 1.7B (~1.1GB)
